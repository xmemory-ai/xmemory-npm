{
  "name": "xmemory",
  "version": "3.8.3",
  "description": "xmemory",
  "keywords": [
    "xmemory"
  ],
  "homepage": "https://github.com/xmemory-ai/xmemory-npm",
  "bugs": {
    "url": "https://github.com/xmemory-ai/xmemory-npm/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xmemory-ai/xmemory-npm.git"
  },
  "license": "MIT",
  "author": "Dima Korolev",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:clean && npm run build:esm && npm run build:cjs",
    "build:clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build:esm": "tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/esm/package.json','{\\\"type\\\":\\\"module\\\"}')\"",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}')\"",
    "test": "tsc --noEmit && node --import tsx test.ts",
    "test:types": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0"
  }
}
